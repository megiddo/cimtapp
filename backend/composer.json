{
    "name": "megiddo/cimtapp",
    "description": "CIMTapp — Compounded Incretin Mimetic Tracking App (Slim 4 API)",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-sodium": "*",
        "monolog/monolog": "^3.8",
        "php-di/php-di": "^7.0",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "infection/infection": "^0.29",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "platform": {
            "php": "8.3.0"
        },
        "process-timeout": 0,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "php -S localhost:24780 -t public public/router.php",
        "test": [
            "@php vendor/bin/phpunit --coverage-clover coverage/clover.xml --coverage-text",
            "@php scripts/check-coverage.php"
        ],
        "test:unit": "phpunit --no-coverage",
        "infection": "infection --threads=max --min-msi=80 --min-covered-msi=85",
        "phpstan": "phpstan analyse --memory-limit=512M"
    }
}
