# Copy to backend/.env for `composer start` outside Docker.
# Generate a 256-bit master key: openssl rand -hex 32

APP_ENV=development

# 256-bit application master key. 64 hex chars OR standard base64 of 32 bytes.
CIMT_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:24780/api/v1/auth/google/callback

DATA_DIR=../data
APP_URL=http://localhost:24780
SESSION_SECURE=false

# Set to 1 inside the Docker image so Monolog writes to stdout.
# docker=true
