# CIMTapp local environment. Copy: cp .env.example .env
# Generate a real 256-bit key with: openssl rand -hex 32

APP_ENV=development

# 256-bit application master key (AMK). 64 hex characters OR base64 of 32 bytes.
# This dummy is for local Docker only — never use it in production.
CIMT_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:24780/api/v1/auth/google/callback

DATA_DIR=/var/www/cimtapp/data
# Dev compose publishes 24780. Production compose publishes 25880 — set APP_URL to match when using make up-prod.
APP_URL=http://localhost:24780
SESSION_SECURE=false

# Monolog writes to stdout when this is set (Docker image sets it too).
docker=true
